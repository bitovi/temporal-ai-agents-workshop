# Rename this file to `.env` and fill in the required values.

# By default we use OpenAI's GPT-4o Mini model.
OPENAI_API_KEY=openai-api-key-placeholder
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Uncomment the following lines to use a local instance of Qwen-2.5 model in Ollama.
# OPENAI_API_KEY=not-used-in-ollama
# OPENAI_MODEL=qwen2.5:14b
# OPENAI_API_BASE=http://localhost:11435

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-queue
TEMPORAL_HOST_PORT=localhost:7233
