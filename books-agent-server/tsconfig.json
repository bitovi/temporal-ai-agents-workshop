{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "../book-agent-server/dist",
    "rootDir": "../book-agent-server",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "../book-agent-server/**/*.ts"
  ],
  "exclude": [
    "../book-agent-server/node_modules",
    "../book-agent-server/dist"
  ]
}
