{
  "name": "support-agent-server",
  "version": "1.0.0",
  "description": "Riot Games Support Agent Server using A2A SDK",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "dev": "ts-node-dev --respawn server.ts",
    "card": "curl http://localhost:4000/.well-known/agent-card.json",
    "build": "tsc",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.9.0",
    "dotenv": "^16.0.0",
    "express": "^4.22.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}