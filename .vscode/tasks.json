{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker Compose Up",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build"
      ],
      "group": "build",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^[+] Building",
          "endsPattern": "Server:  0.0.0.0:7233"
        }
      },
      "detail": "Build and start Docker Compose services",
      "dependsOn": [
        "Sync Environments"
      ]
    },
    {
      "label": "Docker Compose Down",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "down",
        "-v"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Stop and remove Docker Compose services and volumes",
      "dependsOn": [
        "Sync Environments"
      ]
    },
    {
      "label": "Sync Environments",
      "type": "shell",
      "linux": {
        "command": "sh",
        "args": [
          "sync-env.sh"
        ]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "sync-env.ps1"
        ]
      },
      "osx": {
        "command": "sh",
        "args": [
          "sync-env.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "problemMatcher": [],
      "detail": "Copies the root .env file into each exercise"
    },
    {
      "label": "Nuke Environments",
      "type": "shell",
      "linux": {
        "command": "sh",
        "args": [
          "nuke-env.sh"
        ]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "nuke-env.ps1"
        ]
      },
      "osx": {
        "command": "sh",
        "args": [
          "nuke-env.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "problemMatcher": [],
      "detail": "Use if things get messed up and don't seem to be working.",
      "dependsOn": [
        "Sync Environments"
      ]
    },
    {
